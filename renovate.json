{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>dacrab/renovate-config"
  ],
  "packageRules": [
    {
      "description": "This repo has no pull_request CI; never automerge. Package rules win over top-level automerge:false.",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "automerge": false
  }
}
