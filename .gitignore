# Custom .gitignore for dragon-blaze Unity project
# Keep Assets/, ProjectSettings/ and Packages/ tracked; ignore editor- and build-generated content.

# Unity auto-generated project folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity auto-generated files and caches
sysinfo.txt
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db

# Autogenerated JetBrains Rider plugin inside Assets
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / MonoDevelop generated files
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables (generated binary data)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Addressables
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE/editor local configuration (keep user-specific only)
.idea/
.vscode/
*.code-workspace

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local logs and crash dumps
*.log
